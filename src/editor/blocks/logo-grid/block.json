{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "travelopia/logo-grid",
  "title": "Logo Grid",
  "description": "Display a grid of logos.",
  "category": "layout",
  "textdomain": "tp",
  "keywords": ["logo", "grid"],
  "supports": {
    "anchor": true,
    "className": true,
    "customClassName": true,
    "html": false,
    "alignWide": false
  },
  "attributes": {
    "anchor": {
      "type": "string",
      "default": ""
    },
    "hasTitle": {
      "type": "boolean",
      "default": false
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "align": {
      "type": "string",
      "default": "left"
    },
    "logoSize": {
      "type": "string",
      "default": "medium"
    }
  }
}
